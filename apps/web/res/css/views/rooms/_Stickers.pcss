.mx_Stickers_content {
    overflow: hidden;
}

.mx_Stickers_menuWrapper {
    width: 340px;
    height: min(450px, 80vh);
    max-height: 80vh;
}

.mx_Stickers_menu {
    width: 100%;
    height: 100%;
    border-radius: 4px;
    overflow: hidden;
}

.mx_Stickers_menu > div {
    height: 100%;
}

.mx_Stickers_content_container {
    overflow: hidden;
    height: 100%;
}

.mx_Stickers_panel {
    display: flex;
    flex-direction: column;
    height: 100%;
    border-radius: 4px;
    overflow: hidden;
}

.mx_Stickers_header {
    border-bottom: 1px solid $message-action-bar-border-color;
    padding: 4px 8px;
}

.mx_Stickers_body {
    flex: 1 1 auto;
    overflow: auto;
    min-height: 0;
}

.mx_Stickers_content_roomEmotes {
    padding: 8px 10px 12px;
    box-sizing: border-box;
}

.mx_Stickers_section {
    &:not(:last-child) {
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid $header-panel-bg-hover;
    }
}

.mx_Stickers_filters {
    display: flex;
    flex-direction: column;
    gap: 4px;
}

.mx_Stickers_packTabs {
    display: flex;
    align-items: center;
    gap: 4px;
    padding: 0;
    overflow-x: auto;
}

.mx_Stickers_packTab {
    border: none;
    padding: var(--cpd-space-1x) 0;
    font: inherit;
    line-height: 1;
    border-bottom: 2px solid transparent;
    background-color: transparent;
    border-radius: 4px 4px 0 0;
    width: 36px;
    height: 36px;
    color: $primary-content;
    display: inline-flex;
    align-items: center;
    justify-content: center;

    &:not(:disabled) {
        cursor: pointer;
    }

    &:disabled {
        filter: opacity(0.3);
    }

    &:not(:disabled):hover {
        background-color: $focus-bg-color;
        border-bottom: 2px solid $accent;
    }
}

.mx_Stickers_packTab_active {
    border-bottom: 2px solid $accent;
}

.mx_Stickers_packTab svg {
    width: 18px;
    height: 18px;
}

.mx_Stickers_packTabImage {
    width: 24px;
    height: 24px;
    border-radius: 999px;
    object-fit: cover;
}

.mx_Stickers_search {
    margin: 0;
    border-radius: 4px;
    border: none;
    background-color: transparent;
    display: flex;

    .mx_Stickers_searchInput {
        flex: 1;
        border: none;
        padding: 8px 12px;
        border-radius: 4px;
        font-size: $font-12px;
        background: transparent;
        color: $primary-content;
        outline: none;
        box-shadow: none;

        &::placeholder {
            color: var(--cpd-color-text-secondary);
        }
    }

    .mx_Stickers_searchClear {
        border: none;
        background-color: inherit;
        margin: 0;
        padding: 8px;
        align-self: center;
        width: 32px;
        height: 32px;
        cursor: pointer;
        color: $muted-fg-color;
        margin-left: -40px;
    }
}

.mx_Stickers_emptyResults {
    margin: 6px 2px;
    font-size: $font-12px;
    color: $muted-fg-color;
}

.mx_Stickers_sectionTitle {
    margin: 4px 2px 8px;
    color: var(--cpd-color-text-secondary);
    font-size: $font-11px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
}

.mx_Stickers_roomGroup {
    &:not(:last-child) {
        margin-bottom: 10px;
    }
}

.mx_Stickers_roomHeader {
    margin: 6px 2px 4px;
    color: var(--cpd-color-text-secondary);
    font-size: $font-12px;
    font-weight: 600;
}

.mx_Stickers_pack {
    &:not(:first-child) {
        margin-top: 10px;
    }
}

.mx_Stickers_packHeader {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 4px 2px 8px;
    color: var(--cpd-color-text-secondary);
    font-size: $font-12px;
    font-weight: 500;
}

.mx_Stickers_packAvatar {
    width: 24px;
    height: 24px;
    border-radius: 999px;
}

.mx_Stickers_packTitle {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
}

.mx_Stickers_packGrid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(48px, 1fr));
    gap: 8px;
}

.mx_Stickers_packItem {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 4px;
    border-radius: 8px;
    border: 1px solid transparent;
    background: transparent;
    cursor: pointer;

    &:hover {
        border-color: $header-panel-bg-hover;
        background-color: $header-panel-bg-hover;
    }
}

.mx_Stickers_packItemImage {
    width: 100%;
    height: 100%;
    max-width: 64px;
    max-height: 64px;
    object-fit: contain;
}

#mx_persistedElement_stickerPicker {
    .mx_AppTileFullWidth {
        height: unset;
        box-sizing: border-box;
        border-left: none;
        border-right: none;
        border-bottom: none;
    }

    .mx_AppTileMenuBar {
        padding: 0;
    }

    iframe {
        /* Sticker picker depends on the fixed height previously used for all tiles */
        height: 433px; /* height of the popout minus the AppTile menu bar */
    }
}

.mx_Stickers_contentPlaceholder {
    display: flex;
    flex-grow: 1;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
}

.mx_Stickers_contentPlaceholder p {
    max-width: 200px;
}

.mx_Stickers_addLink {
    display: inline;
    cursor: pointer;
    color: $accent;
}
